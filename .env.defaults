# KlaayGuard Default Environment Variables
# This file contains safe defaults that are committed to the repository.
# Copy to .env.defaults in project root and customize as needed.

# Collection interval in seconds (1 hour = 3600 seconds)
KLAAYGUARD_COLLECTION_INTERVAL_SECONDS=3600

# Sentry error tracking DSN (empty by default)
VITE_SENTRY_DSN=

# Build environment (used by build scripts)
# Valid values: development, staging, production
KLAAY_ENV=production

