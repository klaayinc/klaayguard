# KlaayGuard Staging Environment
# Used for staging builds with staging infrastructure
# Copy to .env.staging in project root and customize as needed.

KLAAY_ENV=staging

# API endpoints
VITE_API_BASE_URL=https://api.klaay.dev
VITE_EARTHENWARE_URL=https://app.klaay.dev

# Collection interval (default from .env.defaults)
# KLAAYGUARD_COLLECTION_INTERVAL_SECONDS=3600

# Sentry DSN (optional, configure for staging if needed)
# VITE_SENTRY_DSN=



