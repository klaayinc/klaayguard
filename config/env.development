# KlaayGuard Development Environment
# Used for local development with localhost API
# Copy to .env.development in project root and customize as needed.

KLAAY_ENV=development

# API endpoints
VITE_API_BASE_URL=http://localhost:3000
VITE_EARTHENWARE_URL=http://localhost:5173

# Collection interval (default from .env.defaults)
# KLAAYGUARD_COLLECTION_INTERVAL_SECONDS=3600

# Sentry DSN (optional, leave empty for development)
# VITE_SENTRY_DSN=



