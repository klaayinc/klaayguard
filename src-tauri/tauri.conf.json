{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlaayGuard",
  "version": "0.1.12",
  "identifier": "com.klaay.app",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "vendor/licenses/*",
      "resources/*",
      "icons/icon-success.png",
      "icons/icon-error.png",
      "icons/icon-default.png",
      "icons/icon-unauthenticated.png"
    ],
    "externalBin": [
      "vendor/osqueryi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "share/applications/klaayguard.desktop": "./linux/klaayguard.desktop"
        }
      },
      "appimage": {
        "files": {
          "share/applications/klaayguard.desktop": "./linux/klaayguard.desktop"
        }
      }
    }
  }
}
