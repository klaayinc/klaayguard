{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlaayGuard",
  "version": "0.1.12",
  "identifier": "com.klaay.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build --mode production",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; connect-src 'self' https://api.klaay.com https://api.klaay.dev http://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": ["vendor/licenses/*", "resources/*"],
    "externalBin": ["vendor/osqueryi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "share/applications/klaayguard.desktop": "./linux/klaayguard.desktop"
        }
      },
      "appimage": {
        "files": {
          "share/applications/klaayguard.desktop": "./linux/klaayguard.desktop"
        }
      }
    }
  }
}
