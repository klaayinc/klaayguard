# KlaayGuard Production Environment
# Used for production builds with production infrastructure
# Copy to .env.production in project root and customize as needed.

KLAAY_ENV=production

# API endpoints
VITE_API_BASE_URL=https://api.klaay.com
VITE_EARTHENWARE_URL=https://app.klaay.com

# Collection interval (default from .env.defaults)
# KLAAYGUARD_COLLECTION_INTERVAL_SECONDS=3600

# Sentry DSN (configure in CI/CD or .env.production.local)
# VITE_SENTRY_DSN=

