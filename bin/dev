#!/usr/bin/env bash

# bin/dev - Start KlaayGuard in development mode
# Usage: bin/dev

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NORMAL='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NORMAL}"
echo -e "${BLUE}  KlaayGuard Development Server${NORMAL}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NORMAL}"
echo ""

# Check if Rust is installed
if ! command -v cargo &> /dev/null; then
    echo -e "${YELLOW}⚠  Rust not found.${NORMAL}"
    echo "Please run: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    exit 1
fi

# Check if Tauri CLI is installed
if ! command -v cargo-tauri &> /dev/null; then
    echo -e "${YELLOW}⚠  Tauri CLI not found. Installing...${NORMAL}"
    cargo install tauri-cli --version "^2.0.0"
fi

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load environment variables from .env files
# shellcheck source=../scripts/load-env.sh
source "$SCRIPT_DIR/../scripts/load-env.sh" development

if [ $? -ne 0 ]; then
    echo -e "${YELLOW}⚠  Failed to load environment configuration, using defaults${NORMAL}"
    export VITE_API_BASE_URL="http://localhost:3000"
    export VITE_EARTHENWARE_URL="http://localhost:5173"
    export KLAAYGUARD_COLLECTION_INTERVAL_SECONDS="3600"
fi

# Set development-specific variables
export APP_DEFAULT_API_BASE_URL="$VITE_API_BASE_URL"
export RUST_LOG="info"

echo -e "${GREEN}✓${NORMAL} API URL: $VITE_API_BASE_URL"
echo -e "${GREEN}✓${NORMAL} Earthenware URL: $VITE_EARTHENWARE_URL"
echo -e "${GREEN}✓${NORMAL} Collection Interval: $KLAAYGUARD_COLLECTION_INTERVAL_SECONDS seconds"
echo ""

# Generate Launch Agent plist with current environment variables
echo -e "${BLUE}📝 Generating Launch Agent configuration...${NORMAL}"
printf '<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.klaay.klaayguard-dev</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/KlaayGuard-Dev.app/Contents/MacOS/KlaayGuard-Dev</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>ProcessType</key>
    <string>Interactive</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>VITE_API_BASE_URL</key>
        <string>%s</string>
        <key>VITE_EARTHENWARE_URL</key>
        <string>%s</string>
        <key>KLAAYGUARD_COLLECTION_INTERVAL_SECONDS</key>
        <string>%s</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/tmp/klaayguard-dev-launchd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/klaayguard-dev-launchd-error.log</string>
</dict>
</plist>' "$VITE_API_BASE_URL" "$VITE_EARTHENWARE_URL" "$KLAAYGUARD_COLLECTION_INTERVAL_SECONDS" > com.klaay.klaayguard-dev.plist
echo -e "${GREEN}✓${NORMAL} Plist generated with current environment variables"
echo ""

# Check if dev app bundle needs to be built/updated
DEV_APP_PATH="/Applications/KlaayGuard-Dev.app"
NEEDS_BUILD=0

if [ ! -d "$DEV_APP_PATH" ]; then
    echo -e "${YELLOW}⚠  Dev app not found in Applications folder${NORMAL}"
    NEEDS_BUILD=1
else
    # Check if source is newer than installed app
    if [ -f "src-tauri/src/lib.rs" ]; then
        SRC_MTIME=$(stat -f %m src-tauri/src/lib.rs 2>/dev/null || echo 0)
    else
        SRC_MTIME=0
    fi
    
    if [ -f "$DEV_APP_PATH/Contents/MacOS/KlaayGuard" ]; then
        APP_MTIME=$(stat -f %m "$DEV_APP_PATH/Contents/MacOS/KlaayGuard" 2>/dev/null || echo 0)
    else
        APP_MTIME=0
    fi
    
    if [ "$SRC_MTIME" -gt "$APP_MTIME" ]; then
        echo -e "${YELLOW}⚠  Source code is newer than installed app${NORMAL}"
        NEEDS_BUILD=1
    fi
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
    echo -e "${BLUE}📦 Building and installing dev app bundle...${NORMAL}"
    echo -e "${YELLOW}   This will take a minute...${NORMAL}"
    echo ""
    
    # Build the dev bundle with development environment variables
    export KLAAY_ENV=development
    cargo tauri build --debug --config src-tauri/tauri.development.json
    
    # Kill any running instance
    pkill -f "KlaayGuard-Dev" 2>/dev/null || true
    
    # Remove old dev app
    rm -rf "$DEV_APP_PATH" 2>/dev/null || true
    
    # Copy new dev app to Applications
    if [ -d "src-tauri/target/debug/bundle/macos/KlaayGuard-Dev.app" ]; then
        cp -R "src-tauri/target/debug/bundle/macos/KlaayGuard-Dev.app" /Applications/
        echo -e "${GREEN}✓${NORMAL} Dev app installed to $DEV_APP_PATH"
        
        # Force re-registration of URL scheme
        /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$DEV_APP_PATH"
        echo -e "${GREEN}✓${NORMAL} URL scheme registered for dev app"
    else
        echo -e "${YELLOW}⚠  Build failed - app bundle not found${NORMAL}"
        exit 1
    fi
    echo ""
fi

# Install Launch Agent for auto-restart and keep-alive
LAUNCH_AGENT_PATH="$HOME/Library/LaunchAgents/com.klaay.klaayguard-dev.plist"
echo -e "${BLUE}🔄 Installing Launch Agent for auto-restart...${NORMAL}"

# Unload existing agent if present (kill running instance first)
pkill -f "KlaayGuard" 2>/dev/null || true
launchctl unload "$LAUNCH_AGENT_PATH" 2>/dev/null || true

# Copy the generated plist to LaunchAgents
cp com.klaay.klaayguard-dev.plist "$LAUNCH_AGENT_PATH"
echo -e "${GREEN}✓${NORMAL} Launch Agent plist copied to ~/Library/LaunchAgents/"

# Load the agent
if launchctl load "$LAUNCH_AGENT_PATH" 2>/dev/null; then
    echo -e "${GREEN}✓${NORMAL} Launch Agent loaded - KlaayGuard-Dev will:"
    echo "   • Auto-start on login"
    echo "   • Auto-restart if it crashes"
    echo "   • Use API: $VITE_API_BASE_URL"
else
    echo -e "${YELLOW}⚠  Failed to load Launch Agent, but continuing...${NORMAL}"
fi
echo ""

echo -e "${BLUE}🚀 KlaayGuard-Dev is managed by Launch Agent${NORMAL}"
echo -e "${YELLOW}⚠  App runs in system tray (no window)${NORMAL}"
echo -e "${YELLOW}⚠  Look for 'KlaayGuard-Dev' icon in top-right menu bar${NORMAL}"
echo ""
echo -e "${GREEN}✓${NORMAL} KlaayGuard-Dev will:"
echo "   • Start automatically (Launch Agent is running it)"
echo "   • Restart if it crashes"
echo "   • Start on every login"
echo ""
echo -e "${BLUE}📝 To view logs:${NORMAL}"
echo "   log stream --predicate 'process == \"KlaayGuard-Dev\"' --level info"
echo "   tail -f /tmp/klaayguard-dev-launchd.log"
echo ""
echo -e "${BLUE}🔗 Test deep link:${NORMAL}"
echo "   open 'klaayguard://auth-callback?token=test123'"
echo ""
echo -e "${BLUE}🛑 To stop and disable auto-restart:${NORMAL}"
echo "   launchctl unload ~/Library/LaunchAgents/com.klaay.klaayguard-dev.plist"
echo ""
echo -e "${BLUE}🔄 To restart manually:${NORMAL}"
echo "   launchctl start com.klaay.klaayguard-dev"
echo ""

