#!/usr/bin/env bash

# bin/build - Build KlaayGuard for different environments
# Usage: bin/build <environment>
#   environment: development, staging, or production

set -e  # Exit on error

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NORMAL='\033[0m'

# Check if environment argument is provided
if [ $# -eq 0 ]; then
    echo -e "${RED}✗${NORMAL} Usage: bin/build <environment>"
    echo ""
    echo "  Environments:"
    echo "    development  - Local development build with localhost API"
    echo "    staging      - Staging build with staging API"
    echo "    production   - Production build with production API"
    echo ""
    exit 1
fi

ENVIRONMENT="$1"

# Validate environment
if [[ ! "$ENVIRONMENT" =~ ^(development|staging|production)$ ]]; then
    echo -e "${RED}✗${NORMAL} Invalid environment: $ENVIRONMENT"
    echo "  Valid environments: development, staging, production"
    exit 1
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NORMAL}"
echo -e "${BLUE}  KlaayGuard Build Script - $ENVIRONMENT${NORMAL}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NORMAL}"
echo ""

# Check if Rust is installed
if ! command -v cargo &> /dev/null; then
    echo -e "${RED}✗${NORMAL} Rust not found."
    echo "Please run: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    exit 1
fi

# Check if Tauri CLI is installed
if ! command -v cargo-tauri &> /dev/null; then
    echo -e "${YELLOW}⚠${NORMAL} Tauri CLI not found. Installing..."
    cargo install tauri-cli --version "^2.0.0"
fi

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load environment variables from .env files
# shellcheck source=../scripts/load-env.sh
source "$SCRIPT_DIR/../scripts/load-env.sh" "$ENVIRONMENT"

if [ $? -ne 0 ]; then
    echo -e "${RED}✗${NORMAL} Failed to load environment configuration"
    exit 1
fi

# Determine build mode and config file based on environment
case "$ENVIRONMENT" in
    development)
        BUILD_MODE="debug"
        CONFIG_FILE="src-tauri/tauri.development.json"
        ;;
    staging)
        BUILD_MODE="release"
        CONFIG_FILE="src-tauri/tauri.staging.json"
        ;;
    production)
        BUILD_MODE="release"
        CONFIG_FILE="src-tauri/tauri.conf.json"
        ;;
esac

echo -e "${GREEN}✓${NORMAL} Environment: $ENVIRONMENT"
echo -e "${GREEN}✓${NORMAL} Build Mode: $BUILD_MODE"
echo -e "${GREEN}✓${NORMAL} Config File: $CONFIG_FILE"
echo -e "${GREEN}✓${NORMAL} API URL: $VITE_API_BASE_URL"
echo -e "${GREEN}✓${NORMAL} Earthenware URL: $VITE_EARTHENWARE_URL"
echo ""

# Build the application
echo -e "${BLUE}📦 Building KlaayGuard for $ENVIRONMENT...${NORMAL}"
echo ""

if [ "$BUILD_MODE" = "debug" ]; then
    # Debug build for development
    cargo tauri build --debug --config "$CONFIG_FILE"
else
    # Release build for staging/production
    cargo tauri build --config "$CONFIG_FILE"
fi

if [ $? -ne 0 ]; then
    echo ""
    echo -e "${RED}✗${NORMAL} Build failed"
    exit 1
fi

echo ""
echo -e "${GREEN}✓${NORMAL} Build completed successfully"
echo ""

# Determine output paths based on OS and build mode
OS_TYPE="$(uname -s)"
case "$OS_TYPE" in
    Darwin)
        # macOS
        if [ "$BUILD_MODE" = "debug" ]; then
            BUNDLE_PATH="src-tauri/target/debug/bundle"
        else
            BUNDLE_PATH="src-tauri/target/release/bundle"
        fi
        echo -e "${BLUE}📦 Build artifacts:${NORMAL}"
        echo "  • $BUNDLE_PATH/macos/*.app"
        echo "  • $BUNDLE_PATH/dmg/*.dmg"
        ;;
    Linux)
        if [ "$BUILD_MODE" = "debug" ]; then
            BUNDLE_PATH="src-tauri/target/debug/bundle"
        else
            BUNDLE_PATH="src-tauri/target/release/bundle"
        fi
        echo -e "${BLUE}📦 Build artifacts:${NORMAL}"
        echo "  • $BUNDLE_PATH/appimage/*.AppImage"
        echo "  • $BUNDLE_PATH/deb/*.deb"
        ;;
    *)
        # Windows or other
        if [ "$BUILD_MODE" = "debug" ]; then
            BUNDLE_PATH="src-tauri/target/debug/bundle"
        else
            BUNDLE_PATH="src-tauri/target/release/bundle"
        fi
        echo -e "${BLUE}📦 Build artifacts:${NORMAL}"
        echo "  • $BUNDLE_PATH/msi/*.msi"
        echo "  • $BUNDLE_PATH/nsis/*.exe"
        ;;
esac

echo ""
echo -e "${BLUE}📝 Build Info:${NORMAL}"
echo "  • Environment: $ENVIRONMENT"
echo "  • Build Mode: $BUILD_MODE"
echo "  • API URL: $VITE_API_BASE_URL"
echo "  • Earthenware URL: $VITE_EARTHENWARE_URL"
echo ""
