#!/usr/bin/env bash
# Pre-commit hook for Rust project
# Delegates to bin/check

# Get the git root directory
GIT_ROOT="$(git rev-parse --show-toplevel)"
cd "$GIT_ROOT"

if [[ -x bin/check ]]; then
    bin/check
    exit $?
else
    echo "Error: bin/check not found or not executable. Please ensure it exists and has execute permissions." >&2
    exit 1
fi
